+/// M0-D91's scratch probe (never in the tree): heat_ceiling.bin's step, one slot a submission, the solve's planes read
+/// after each (D91_TRACE), then both of (4)'s measures by cell, slot by slot, the true residual and an f64 solve of pass 1.
+mod d91 {
+    use super::*;
+
+    fn cut() -> (State, Physics, f64) {
+        let file = std::env::var("D91_CUT").unwrap_or("heat_ceiling.bin".into());
+        let dump = Dump::read(&scenes_dir().join(&file)).unwrap();
+        let (w, h) = (dump.world.width as usize, dump.world.height as usize);
+        let st = State::new(w, h, dump.planes.iter().map(|&v| f64::from(v)).collect());
+        let mut physics = Physics::shipped().unwrap();
+        if std::env::var("D91_TODAY").is_err() {
+            physics = physics.with(&[("a_r", 4e-5), ("c_sb", 200.0)]).unwrap();
+        }
+        (st, physics, f64::from(dump.resume.dt_next))
+    }
+
+    struct Slot {
+        mode: u32,
+        passes: u32,
+        rounds: u32,
+        u_bound: f32,
+        t_bound: f32,
+        gamma: f32,
+        p: usize,
+    }
+
+    fn slot_of(m: &[f32]) -> Slot {
+        let rec = |k: usize| &m[16 * k..16 * k + 16];
+        let bits = |v: f32| v.to_bits();
+        let p = if bits(rec(0)[0]) >= bits(rec(1)[0]) { 0 } else { 1 };
+        let r = rec(p);
+        Slot { mode: bits(r[1]), passes: bits(r[2]), rounds: bits(r[3]), u_bound: r[10], t_bound: r[11], gamma: r[12], p }
+    }
+
+    #[test]
+    fn d91_probe() {
+        let precond = if std::env::var("D91_MG").is_ok() { sr_engine::step::heat::HeatPrecond::Multigrid } else { sr_engine::step::heat::HeatPrecond::Jacobi };
+        on_precond(precond, run);
+    }
+
+    fn run() {
+        let (st, physics, dt) = cut();
+        let a_r = physics.get("a_r").unwrap();
+        let t_floor = Eos::from_physics(&physics).unwrap().t_floor();
+        let gpu = OnGpu::new(&physics, TestFlags::default(), &st);
+        let dt = dt * std::env::var("D91_DTX").ok().and_then(|s| s.parse::<f64>().ok()).unwrap_or(1.0);
+        if std::env::var("D91_ALL").is_ok() {
+            let before = gpu.first.clone();
+            let rep = gpu.pass(dt);
+            let after = gpu.planes();
+            let radiated: f64 = gpu.radiated().iter().sum();
+            let n = before.cells();
+            let lost: f64 = (0..n).map(|i| before.planes[3 * n + i] - after.planes[3 * n + i]).sum();
+            println!("D91 report {rep:?} dt {dt:e} radiated {radiated:.6e} grid lost {lost:.6e}");
+            return;
+        }
+        let dir = std::env::var("D91_DIR").unwrap();
+        std::fs::create_dir_all(&dir).unwrap();
+        unsafe { std::env::set_var("D91_TRACE", &dir) };
+        let (rep, subs) = gpu.pass_in(dt, Some(1));
+        unsafe { std::env::remove_var("D91_TRACE") };
+        println!("D91 report {rep:?} submissions {subs} dt {dt:e} a_r {a_r:e}");
+        analyse(&dir, st.width, st.height, a_r, t_floor, subs as usize, 0);
+    }
+
+    /// A trace taken by a headless run (D91_DIR, D91_W, D91_H, D91_FIRST: the first submission of the step; today's a_r).
+    #[test]
+    fn d91_analyse() {
+        let Ok(dir) = std::env::var("D91_DIR") else { return };
+        let get = |k: &str| std::env::var(k).unwrap().parse::<usize>().unwrap();
+        let physics = Physics::shipped().unwrap();
+        let t_floor = Eos::from_physics(&physics).unwrap().t_floor();
+        let subs = std::fs::read_dir(&dir).unwrap().count();
+        analyse(&dir, get("D91_W"), get("D91_H"), physics.get("a_r").unwrap(), t_floor, get("D91_FIRST") + subs - 1, get("D91_FIRST"));
+    }
+
+    fn analyse(dir: &str, w: usize, h: usize, a_r: f64, t_floor: f64, subs: usize, first: usize) {
+        let u_vac = a_r * t_floor.powi(4);
+        let mut dt = 0.0;
+        let mut t_prev: Option<Vec<f32>> = None;
+        let mut moved_by: Vec<u32> = vec![0; w * h];
+        let mut sign_flips: Vec<u32> = vec![0; w * h];
+        let mut last_dir: Vec<i8> = vec![0; w * h];
+        let n = w * h;
+        let nxf = (w + 1) * h;
+        let every: usize = std::env::var("D91_EVERY").ok().and_then(|s| s.parse().ok()).unwrap_or(256);
+        let mut x_start: Vec<f64> = vec![0.0; n];
+        let mut r0: Vec<f64> = vec![0.0; n];
+        let mut pass1: Option<(Vec<f64>, Vec<f64>, Vec<f64>, Vec<f64>, Vec<f64>)> = None; // (c, d_faces flat, gas, r0, x_start)
+        let mut last_x: Vec<f64> = vec![0.0; n];
+        let mut prev_mode = u32::MAX;
+        let mut prev_passes = u32::MAX;
+        for k in first.max(1)..=subs {
+            let path = format!("{dir}/sub_{k:06}.bin");
+            let Ok(bytes) = std::fs::read(&path) else { continue };
+            let v: Vec<f32> = bytes.chunks_exact(4).map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]])).collect();
+            let faces_len = 2 * ((w + 1) * h + w * (h + 1));
+            let m_len = v.len() - 16 * n - faces_len;
+            let (frozen, rest) = v.split_at(5 * n);
+            let (solve, rest) = rest.split_at(5 * n);
+            let (krylov, rest) = rest.split_at(6 * n);
+            let (mach, faces) = rest.split_at(m_len);
+            let s = slot_of(mach);
+            dt = f64::from(mach[16 * s.p + 8]);
+            let cap = &frozen[n..2 * n];
+            let t0 = &frozen[0..n];
+            let gas: Vec<bool> = (0..n).map(|i| cap[i] > 0.0).collect();
+            let tt = &solve[n..2 * n];
+            let d = &solve[3 * n..4 * n];
+            let x: Vec<f64> = (0..n).map(|i| f64::from(solve[i]) + f64::from(solve[4 * n + i])).collect();
+            let r = &krylov[s.p * n..(s.p + 1) * n];
+            let fd = |i: usize| -> [(f64, Option<usize>); 4] {
+                let (cx, cy) = (i % w, i / w);
+                let nb = |dx: isize, dy: isize| -> Option<usize> {
+                    let (ox, oy) = (cx as isize + dx, cy as isize + dy);
+                    if ox < 0 || oy < 0 || ox >= w as isize || oy >= h as isize {
+                        return None;
+                    }
+                    let o = oy as usize * w + ox as usize;
+                    gas[o].then_some(o)
+                };
+                [
+                    (f64::from(faces[cy * (w + 1) + cx]), nb(-1, 0)),
+                    (f64::from(faces[cy * (w + 1) + cx + 1]), nb(1, 0)),
+                    (f64::from(faces[nxf + cy * w + cx]), nb(0, -1)),
+                    (f64::from(faces[nxf + (cy + 1) * w + cx]), nb(0, 1)),
+                ]
+            };
+            let heat = |i: usize| f64::from(cap[i]) / dt;
+            let slope = |i: usize| 1.0 / (4.0 * a_r * f64::from(tt[i]).powi(3));
+            let c = |i: usize| heat(i) * slope(i);
+            // After a RESID slot (the machine now in DO_START = 2) the pass's start: x and r.
+            if s.mode == 2 && prev_mode != 2 {
+                x_start = x.clone();
+                r0 = (0..n).map(|i| f64::from(r[i])).collect();
+                if s.passes == 1 && pass1.is_none() {
+                    let cs: Vec<f64> = (0..n).map(|i| if gas[i] { c(i) } else { 0.0 }).collect();
+                    let df: Vec<f64> = (0..n).flat_map(|i| fd(i).map(|f| f.0)).collect();
+                    let gs: Vec<f64> = gas.iter().map(|&g| if g { 1.0 } else { 0.0 }).collect();
+                    pass1 = Some((cs, df, gs, r0.clone(), x_start.clone()));
+                }
+            }
+            if s.passes != prev_passes {
+                prev_passes = s.passes;
+                let cap_sum_t0: f64 = (0..n).filter(|&i| gas[i]).map(|i| f64::from(cap[i]) * f64::from(t0[i])).sum();
+                if let Some(tp) = &t_prev {
+                    let mut moved = 0.0;
+                    let mut over = Vec::new();
+                    for i in (0..n).filter(|&i| gas[i]) {
+                        let dif = f64::from(tt[i]) - f64::from(tp[i]);
+                        moved += f64::from(cap[i]) * dif.abs();
+                        if dif.abs() > 1e-3 * f64::from(tp[i]) {
+                            over.push((dif.abs() / f64::from(tp[i]), i, dif));
+                            moved_by[i] += 1;
+                            let dr: i8 = if dif > 0.0 { 1 } else { -1 };
+                            if last_dir[i] != 0 && last_dir[i] != dr {
+                                sign_flips[i] += 1;
+                            }
+                            last_dir[i] = dr;
+                        }
+                    }
+                    over.sort_by(|a, b| b.0.total_cmp(&a.0));
+                    let list: Vec<String> = over.iter().take(4).map(|(q, i, d)| format!("({},{}) {:+.3e} rel {:.2e} T {:.3e}", i % w, i / w, d, q, tp[*i])).collect();
+                    println!(
+                        "D91 newton pass {} rounds {} | ΣC|ΔT| {:.3e} vs 1e-6 ΣC T0 {:.3e} | cells over 1e-3: {} | {}",
+                        s.passes, s.rounds, moved, 1e-6 * cap_sum_t0, over.len(), list.join(" ; ")
+                    );
+                }
+                t_prev = Some(tt.to_vec());
+            }
+            prev_mode = s.mode;
+            let gas_ids: Vec<usize> = (0..n).filter(|&i| gas[i]).collect();
+            let mut mu = 0.0;
+            let mut mt = 0.0;
+            let mut mtrue = 0.0;
+            let mut top_u = (0.0, 0usize);
+            let mut top_t = (0.0, 0usize);
+            let mut top_true = (0.0, 0usize);
+            for &i in &gas_ids {
+                let di = f64::from(d[i]);
+                let ri = f64::from(r[i]);
+                let tu = ri * ri / di;
+                let e = ri * slope(i) / di;
+                let tt_ = heat(i) * e * e;
+                // b − A x at x, the pass's linearisation at x_start (its T the pass's T).
+                let mut rt = -heat(i) * (f64::from(tt[i]) - f64::from(t0[i])) - c(i) * (x[i] - x_start[i]);
+                for (df, o) in fd(i) {
+                    let far = match o {
+                        Some(o) => x[o],
+                        None => u_vac,
+                    };
