+//! M0-R11 scratch: the unresolved-remnant candidates on the twin, picked by `SR_R11` (0 | N | D | H), never in the tree.
+//! N — P8 borrows a cell's thermal deficit from its four neighbours' heat above their floor (each gives ≤ ¼ of it) before
+//!     the floor refills the rest.
+//! D — dual energy (Bryan et al. 1995): Σε_th carried beside E, advected upwind with the mass flux plus −Π_th ∇·u, P5's
+//!     and P6's changes added; where the conservative ε_th < η ε_cold, E is re-synced to it, the change booked `sync`.
+//! H — held core: a cell with Σ ≥ Σ_hold and ε_th ≤ η ε_cold is held — P4 leaves it as it is, its faces to free cells
+//!     are walls (the free side's pressure), no work across them; P5, P6, P8 run on it; released past 2η or ½Σ_hold.
+
+use super::hydro::State;
+use crate::eos::Eos;
+use crate::registry::{Elements, N_SPECIES};
+
+pub struct Cand {
+    pub variant: char,
+    pub eta: f64,
+    pub sigma_hold: f64,
+    eos: Eos,
+    elements: Elements,
+    sigma_vac: f64,
+    /// D: Σε_th per cell.
+    pub aux: Vec<f64>,
+    /// H: the held mask.
+    pub held: Vec<bool>,
+    pub sync: f64,
+    pub borrowed: f64,
+    pub held_mom: [f64; 2],
+}
+
+/// (Σ, raw Σε_th, Σε_cold, Σε_floor, |p|²/2Σ) of cell i.
+pub fn thermo(eos: &Eos, el: &Elements, st: &State, i: usize) -> (f64, f64, f64, f64, f64) {
+    let s = st.get(0, i);
+    let x: [f64; N_SPECIES] = std::array::from_fn(|k| st.get(4 + k, i));
+    let comp = el.composition(&x);
+    let ke = 0.5 * (st.get(1, i).powi(2) + st.get(2, i).powi(2)) / s;
+    let cold = s * eos.eps_cold(s, comp.y_e, x[N_SPECIES - 1]);
+    let floor = s * eos.t_floor() * comp.inv_mu;
+    (s, st.get(3, i) - ke - cold, cold, floor, ke)
+}
+
+impl Cand {
+    pub fn new(eos: Eos, elements: Elements, sigma_vac: f64, st: &State) -> Cand {
+        let variant = std::env::var("SR_R11").ok().and_then(|v| v.chars().next()).unwrap_or('0');
+        let eta = std::env::var("SR_R11_ETA").ok().map_or(0.1, |v| v.parse().unwrap());
+        let sigma_hold = std::env::var("SR_R11_SHOLD").ok().map_or(10.0, |v| v.parse().unwrap());
+        let n = st.cells();
+        let mut c = Cand {
+            variant,
+            eta,
+            sigma_hold,
+            eos,
+            elements,
+            sigma_vac,
+            aux: vec![0.0; n],
+            held: vec![false; n],
+            sync: 0.0,
+            borrowed: 0.0,
+            held_mom: [0.0; 2],
+        };
+        for i in 0..n {
+            let (_, eth, _, floor, _) = c.th(st, i);
+            c.aux[i] = eth.max(floor);
+        }
+        c
+    }
+
+    pub fn th(&self, st: &State, i: usize) -> (f64, f64, f64, f64, f64) {
+        thermo(&self.eos, &self.elements, st, i)
+    }
+
+    /// D after P4: Σε_th advected with the step's mass fluxes (upwind specific ε_th) and −Π_th ∇·u (γ = 2: Π_th = Σε_th),
+    /// ∇·u by central differences of the velocities the step started from. `before` is the state P4 started from.
+    pub fn advect(&mut self, before: &State, after: &State, fx: &[f64], fy: &[f64], dt: f64) {
+        let (w, h) = (before.width, before.height);
+        let spec = |i: usize| {
+            let s = before.get(0, i);
+            if s < self.sigma_vac {
+                self.eos.t_floor() * 0.6
+            } else {
+                self.aux[i] / s
+            }
+        };
+        let vel = |i: usize, c: usize| {
+            let s = before.get(0, i);
+            if s < self.sigma_vac {
+                0.0
+            } else {
+                before.get(c, i) / s
+            }
+        };
+        let mut next = self.aux.clone();
+        for y in 0..h {
+            for x in 0..w {
+                let i = y * w + x;
+                if after.get(0, i) < self.sigma_vac {
+                    continue;
+                }
+                let up = |q: f64, lo: usize, hi: usize| q * if q > 0.0 { spec(lo) } else { spec(hi) };
+                let fl = if x > 0 { up(fx[y * (w + 1) + x], i - 1, i) } else { fx[y * (w + 1)] * spec(i) };
+                let fr = if x + 1 < w { up(fx[y * (w + 1) + x + 1], i, i + 1) } else { fx[y * (w + 1) + w] * spec(i) };
+                let fu = if y > 0 { up(fy[y * w + x], i - w, i) } else { fy[x] * spec(i) };
+                let fd = if y + 1 < h { up(fy[(y + 1) * w + x], i, i + w) } else { fy[h * w + x] * spec(i) };
+                let ux = if x > 0 && x + 1 < w { 0.5 * (vel(i + 1, 1) - vel(i - 1, 1)) } else { 0.0 };
+                let vy = if y > 0 && y + 1 < h { 0.5 * (vel(i + w, 2) - vel(i - w, 2)) } else { 0.0 };
+                next[i] = self.aux[i] - dt * (fr - fl + fd - fu) - dt * self.aux[i] * (ux + vy);
+            }
+        }
+        self.aux = next;
+    }
+
+    /// D in P8, before the floors: re-sync E where the gas is cold-dominated, else take the conservative value.
+    pub fn resync(&mut self, st: &mut State) {
+        let n = st.cells();
+        for i in 0..n {
+            let (s, eth, cold, floor, _) = self.th(st, i);
+            if s < self.sigma_vac {
+                self.aux[i] = floor;
+                continue;
+            }
+            if eth < self.eta * cold {
+                let a = self.aux[i].max(floor);
+                self.sync += a - eth;
+                st.planes[3 * n + i] += a - eth;
+                self.aux[i] = a;
+            } else {
+                self.aux[i] = eth.max(floor);
+            }
+        }
+    }
+
+    /// N in P8, before the floors: each short cell borrows from its four neighbours' heat above their floor, ≤ ¼ each.
+    pub fn borrow(&mut self, st: &mut State) {
+        let (w, h, n) = (st.width, st.height, st.cells());
+        let mut deficit = vec![0.0; n];
+        let mut heat = vec![0.0; n];
+        for i in 0..n {
+            let (s, eth, _, floor, _) = self.th(st, i);
+            if s < self.sigma_vac || !eth.is_finite() {
+                continue;
+            }
+            deficit[i] = (floor - eth).max(0.0);
+            heat[i] = (eth - floor).max(0.0);
+        }
+        let mut delta = vec![0.0; n];
+        for y in 0..h {
+            for x in 0..w {
+                let i = y * w + x;
+                if deficit[i] <= 0.0 {
+                    continue;
+                }
+                let nb: Vec<usize> = [(x > 0, i.wrapping_sub(1)), (x + 1 < w, i + 1), (y > 0, i.wrapping_sub(w)), (y + 1 < h, i + w)]
+                    .iter()
+                    .filter(|(ok, _)| *ok)
+                    .map(|&(_, j)| j)
+                    .collect();
+                let offer: f64 = nb.iter().map(|&j| 0.25 * heat[j]).sum();
+                if offer <= 0.0 {
+                    continue;
+                }
+                let take = deficit[i].min(offer);
+                delta[i] += take;
+                for &j in &nb {
+                    delta[j] -= take * 0.25 * heat[j] / offer;
+                }
+                self.borrowed += take;
+            }
+        }
+        for i in 0..n {
+            st.planes[3 * n + i] += delta[i];
+        }
+    }
+
+    /// H at the end of the step: the mask for the next; a newly held cell's momentum zeroed (its KE left in E as heat),
+    /// the momentum booked in `held_mom`.
+    pub fn update_held(&mut self, st: &mut State) {
+        let n = st.cells();
+        for i in 0..n {
+            let (s, eth, cold, _, _) = self.th(st, i);
+            if self.held[i] {
+                if eth > 2.0 * self.eta * cold || s < 0.5 * self.sigma_hold {
+                    self.held[i] = false;
+                }
+            } else if s >= self.sigma_hold && eth <= self.eta * cold {
+                self.held[i] = true;
+                self.held_mom[0] += st.planes[n + i];
+                self.held_mom[1] += st.planes[2 * n + i];
+                st.planes[n + i] = 0.0;
+                st.planes[2 * n + i] = 0.0;
+            }
+        }
+    }
+}
