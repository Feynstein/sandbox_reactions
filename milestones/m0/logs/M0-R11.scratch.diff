+//! R11 scratch: calibrate's grid SCF cold C/O disk of `mass` (shipped K's, T_floor, 64 × 64, bounce), gravity and hydro
+//! only, the candidate by SR_R11. Args: <mass> <steps> [every].
+use sr_engine::calibrate::{cold_disk_scene, Matter};
+use sr_physics::reference::hydro::Edge;
+use sr_physics::reference::{Switches, Twin};
+use sr_physics::registry::{Elements, Physics};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let mass: f64 = args[1].parse().unwrap();
+    let steps: u64 = args[2].parse().unwrap();
+    let every: u64 = args.get(3).map_or(100, |a| a.parse().unwrap());
+    let physics = Physics::shipped().unwrap();
+    let elements = Elements::shipped().unwrap();
+    let (scene, planes) = cold_disk_scene(mass, Matter::CarbonOxygen, &physics, &elements, &[]).unwrap().expect("a disk settles");
+    let (w, h) = (scene.world.width as usize, scene.world.height as usize);
+    let p: Vec<f64> = planes.iter().map(|&v| f64::from(v)).collect();
+    let sw = Switches { gravity: true, hydro: true, heat: false, reactions: false };
+    let mut twin = Twin::new(&physics, &elements, Edge::Bounce, sw, None, w, h, p).unwrap();
+    let probe = |t: &Twin| {
+        let st = &t.state;
+        let (mut ke, mut umax, mut smax, mut m, mut held, mut over10) = (0.0f64, 0.0f64, 0.0f64, 0.0f64, 0usize, 0usize);
+        for i in 0..st.cells() {
+            let s = st.get(0, i);
+            let (px, py) = (st.get(1, i), st.get(2, i));
+            if s > 0.0 {
+                ke += 0.5 * (px * px + py * py) / s;
+            }
+            if s > 1e-3 {
+                umax = umax.max((px * px + py * py).sqrt() / s);
+            }
+            smax = smax.max(s);
+            m += s;
+            held += usize::from(t.cand.held.get(i).copied().unwrap_or(false));
+            over10 += usize::from(s >= 10.0);
+        }
+        (ke, umax, smax, m, held, over10)
+    };
+    let (ke, umax, smax, m, held, over10) = probe(&twin);
+    println!("variant {} eta {} sigma_hold {} mass {mass} world {w}x{h} M {m:.3} Smax {smax:.3} ke {ke:.3e} umax {umax:.3e} held {held} cells>=10 {over10}", twin.cand.variant, twin.cand.eta, twin.cand.sigma_hold);
+    for k in 1..=steps {
+        twin.step();
+        if k % every == 0 || k == steps || k == 50 {
+            let (ke, umax, smax, _, held, over10) = probe(&twin);
+            println!(
+                "step {k:>6} t {:.2} floor {:.4e} sync {:+.4e} borrowed {:.3e} ke {ke:.3e} umax {umax:.3e} Smax {smax:.3} held {held} cells>=10 {over10}",
+                twin.sim_time(), twin.booked.floor_added, twin.cand.sync, twin.cand.borrowed
+            );
+        }
+        if twin.first_non_finite().is_some() {
+            println!("NON-FINITE at step {k}");
+            break;
+        }
+    }
+    println!("held_mom ({:.3e},{:.3e})", twin.cand.held_mom[0], twin.cand.held_mom[1]);
+}
