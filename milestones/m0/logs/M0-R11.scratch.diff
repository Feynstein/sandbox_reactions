+//! R11 scratch: M0-D67's crop of a GPU dump (box [248,144,104,104] into 128 × 128, vacuum outside), all passes, the
+//! candidate by SR_R11. Args: <dump> <steps> [every].
+use sr_engine::dump::Dump;
+use sr_engine::scene::Scene;
+use sr_engine::state::WorldConfig;
+use sr_physics::reference::hydro::Edge;
+use sr_physics::reference::{heat, react, Burning, Switches, Twin};
+use sr_physics::registry::{Elements, Reactions};
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let dump = Dump::read(std::path::Path::new(&args[1])).unwrap();
+    let steps: u64 = args[2].parse().unwrap();
+    let every: u64 = args.get(3).map_or(500, |a| a.parse().unwrap());
+    let (w0, h0) = (dump.world.width as usize, dump.world.height as usize);
+    let scene = Scene::preset("sun", WorldConfig::new(w0 as u32, h0 as u32).unwrap()).unwrap();
+    let physics = scene.physics().unwrap();
+    let elements = Elements::shipped().unwrap();
+    let (bx, by, bw, bh, n, off) = (248usize, 144usize, 104usize, 104usize, 128usize, 12usize);
+    let ch = dump.planes.len() / (w0 * h0);
+    let mut p = vec![0.0f64; ch * n * n];
+    for c in 0..ch {
+        for y in 0..n {
+            for x in 0..n {
+                let (sx, sy) = (x as i64 - off as i64 + bx as i64, y as i64 - off as i64 + by as i64);
+                let inside = x >= off && x < off + bw && y >= off && y < off + bh;
+                let src = if inside { sy as usize * w0 + sx as usize } else { 0 };
+                p[c * n * n + y * n + x] = f64::from(dump.planes[c * w0 * h0 + src]);
+            }
+        }
+    }
+    let sw = Switches { gravity: true, hydro: true, heat: scene.switches.heat, reactions: scene.switches.reactions };
+    let records = Reactions::shipped(&elements, &physics).unwrap();
+    let burning = Burning { heat: heat::TestFlags::default(), react: react::TestFlags { pin_temperature: false }, reactions: &records, neutrinos: scene.switches.neutrinos };
+    let mut twin = Twin::new(&physics, &elements, Edge::Leave, sw, Some(burning), n, n, p).unwrap();
+    let c = &twin.cand;
+    println!("variant {} eta {} sigma_hold {} dump {} step {} switches {:?}", c.variant, c.eta, c.sigma_hold, args[1], dump.step, sw);
+    let probe = |t: &Twin| {
+        let st = &t.state;
+        let (mut ke, mut umax, mut smax, mut heat, mut held) = (0.0f64, 0.0f64, 0.0f64, 0.0f64, 0usize);
+        let mut imax = 0;
+        for i in 0..st.cells() {
+            let s = st.get(0, i);
+            let (px, py) = (st.get(1, i), st.get(2, i));
+            ke += 0.5 * (px * px + py * py) / s;
+            if s > 1.0 {
+                umax = umax.max((px * px + py * py).sqrt() / s);
+                let (_, eth, _, floor, _) = t.cand.th(st, i);
+                heat += (eth - floor).max(0.0);
+            }
+            if s > smax {
+                (smax, imax) = (s, i);
+            }
+            held += usize::from(t.cand.held.get(i).copied().unwrap_or(false));
+        }
+        let (_, eth, cold, _, _) = t.cand.th(st, imax);
+        let (mut eth_all, mut cold_all, mut wpot) = (0.0f64, 0.0f64, 0.0f64);
+        for i in 0..st.cells() {
+            let (s, e, c, _, _) = t.cand.th(st, i);
+            eth_all += e;
+            cold_all += c;
+            if let Some(g) = &t.g {
+                wpot += 0.5 * s * g.phi[i];
+            }
+        }
+        let esc = st.escaped_total()[3];
+        let mass: f64 = (0..st.cells()).map(|i| st.get(0, i)).sum::<f64>() + st.escaped_total()[0];
+        format!("ke {ke:.3e} umax(S>1) {umax:.3e} Smax {smax:.2} at ({},{}) eth/cold_c {:.2e} heat(S>1) {heat:.3e} held {held} | Eth {eth_all:.5e} Ecold {cold_all:.5e} W {wpot:.5e} esc {esc:.4e} mass {mass:.6e}", imax % st.width, imax / st.width, eth / cold)
+    };
+    println!("step +    0 {}", probe(&twin));
+    let rec = |t: &Twin| [t.booked.floor_added, t.cand.sync, t.cand.borrowed, t.radiated, t.nuclear];
+    let mut last = rec(&twin);
+    let mut marks = vec![(0u64, last)];
+    for k in 1..=steps {
+        twin.step();
+        if k % every == 0 || k == steps {
+            let r = rec(&twin);
+            println!(
+                "step +{k:>5} floor +{:.3e} sync {:+.3e} borrowed +{:.3e} radiated +{:.3e} nuclear +{:.3e} {} unconv {} t {:.2}",
+                r[0] - last[0], r[1] - last[1], r[2] - last[2], r[3] - last[3], r[4] - last[4], probe(&twin), twin.unconverged, twin.sim_time()
+            );
+            if std::env::var("R11_CELLS").is_ok() {
+                let st = &twin.state;
+                let imax = (0..st.cells()).max_by(|&a, &b| st.get(0, a).total_cmp(&st.get(0, b))).unwrap();
+                let mut idx: Vec<usize> = (0..st.cells()).collect();
+                idx.sort_by(|&a, &b| twin.floor_cells[b].abs().total_cmp(&twin.floor_cells[a].abs()));
+                for &i in idx.iter().take(4) {
+                    let (dx, dy) = ((i % st.width) as i64 - (imax % st.width) as i64, (i / st.width) as i64 - (imax / st.width) as i64);
+                    println!("        floor cell d=({dx},{dy}) +{:.3e} S {:.3e} u ({:.2e},{:.2e})", twin.floor_cells[i], st.get(0, i), st.get(1, i) / st.get(0, i), st.get(2, i) / st.get(0, i));
+                }
+                twin.floor_cells.iter_mut().for_each(|v| *v = 0.0);
+            }
+            let d = twin.deficit;
+            println!("      deficit new after P4 held {:.3e} free {:.3e} · P5 held {:.3e} free {:.3e} · P6 held {:.3e} free {:.3e}", d[0][0], d[0][1], d[1][0], d[1][1], d[2][0], d[2][1]);
+            twin.deficit = [[0.0; 2]; 3];
+            last = r;
+            marks.push((k, r));
+        }
+        if twin.first_non_finite().is_some() {
+            println!("NON-FINITE at step +{k}");
+            break;
+        }
+    }
+    let win = |a: u64, b: u64| {
+        let f = |k: u64| marks.iter().find(|m| m.0 == k).map(|m| m.1);
+        if let (Some(x), Some(y)) = (f(a), f(b)) {
+            let d: Vec<f64> = (0..5).map(|j| y[j] - x[j]).collect();
+            println!(
+                "RESULT {} window {a}-{b} floor {:.4e} sync {:+.4e} borrowed {:.4e} radiated {:.4e} nuclear {:.4e} floor/rad {:.3} (floor+sync)/rad {:.3}",
+                twin.cand.variant, d[0], d[1], d[2], d[3], d[4], d[0] / d[3], (d[0] + d[1]) / d[3]
+            );
+        }
+    };
+    win(0, 5000);
+    win(5000, 10000);
+    win(0, 10000);
+    println!("held_mom ({:.3e},{:.3e}) unconverged {}", twin.cand.held_mom[0], twin.cand.held_mom[1], twin.unconverged);
+}
