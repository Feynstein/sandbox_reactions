+def git_files(paths):
+    """The old listing, kept as the selftest's plant: git's files under the pathspecs; None when git cannot list."""
+    r = subprocess.run(["git", "--no-optional-locks", "ls-files", "-co", "--exclude-standard", "-z", "--", *paths],
