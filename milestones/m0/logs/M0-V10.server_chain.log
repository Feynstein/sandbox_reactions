# M0-V10 — the server's two chains (laserax-ai-server, /tmp/v10/chain.sh then chain2.sh), verbatim
#!/usr/bin/env bash
cd ~/workspace/sandbox_reactions
export SR_TEST_ADAPTER="RTX 4090"
stamp() { echo "=== $(date -Iseconds) $*"; }
stamp "--all"; t0=$(date +%s.%N)
python3 tools/pb/verify.py --all --task M0-V10; echo "exit $? wall $(echo "$(date +%s.%N) - $t0" | bc) s"
for s in ending age_clock formats multi edits edits_file; do
  stamp "--redarm $s"; t0=$(date +%s.%N)
  python3 tools/pb/verify.py --redarm $s --task M0-V10; echo "exit $? wall $(echo "$(date +%s.%N) - $t0" | bc) s"
done
B=build/target/release/sandbox-reactions
for m in 300 325 350; do
  stamp "wisp probe $m"; $B headless --scene /tmp/v10/wisp_$m.json --steps 1 --adapter "RTX 4090" --out /tmp/v10/wisp_$m.out 2>&1 | tail -3; echo "exit ${PIPESTATUS[0]}"
done
for n in 1 2 3; do stamp "paint_cold steps $n"; $B headless --scene /tmp/v10/paint_cold.json --steps $n --edits /tmp/v10/paint_edits.json --adapter "RTX 4090" --out /tmp/v10/pc_$n.out 2>&1 | tail -2; echo "exit ${PIPESTATUS[0]}"; done
stamp "paint_hot steps 1"; $B headless --scene /tmp/v10/paint_hot.json --steps 1 --adapter "RTX 4090" --out /tmp/v10/ph_1.out 2>&1 | tail -2; echo "exit ${PIPESTATUS[0]}"
stamp "paint_cold steps 200"; $B headless --scene /tmp/v10/paint_cold.json --steps 200 --edits /tmp/v10/paint_edits.json --adapter "RTX 4090" --out /tmp/v10/pc_200.out 2>&1 | tail -3; echo "exit ${PIPESTATUS[0]}"
stamp "paint_hot steps 200"; $B headless --scene /tmp/v10/paint_hot.json --steps 200 --adapter "RTX 4090" --out /tmp/v10/ph_200.out 2>&1 | tail -3; echo "exit ${PIPESTATUS[0]}"
stamp "done"
