----- chain2.sh
#!/usr/bin/env bash
cd ~/workspace/sandbox_reactions
export SR_TEST_ADAPTER="RTX 4090"
B=build/target/release/sandbox-reactions
stamp() { echo "=== $(date -Iseconds) $*"; }
run() { stamp "$1"; shift; $B headless "$@" --adapter "RTX 4090" 2>&1 | grep -v "^SR-ADAPTER" | tail -2; echo "exit ${PIPESTATUS[0]}"; }
for n in 1 2 3 200; do run "A wide_cold, paint inside the box at (64,64), steps $n" --scene /tmp/v10/wide_cold.json --steps $n --edits /tmp/v10/paint_mid.json --out /tmp/v10/A_$n.out; done
for n in 1 2 3 200; do run "B box_hot, paint outside the box at (96,96), steps $n" --scene /tmp/v10/box_hot.json --steps $n --edits /tmp/v10/paint_edits.json --out /tmp/v10/B_$n.out; done
for n in 3 200; do run "C wide_hot, paint inside the box at (64,64), steps $n" --scene /tmp/v10/wide_hot.json --steps $n --edits /tmp/v10/paint_mid.json --out /tmp/v10/C_$n.out; done
for n in 3 200; do run "D wide_cold, no paint, steps $n" --scene /tmp/v10/wide_cold.json --steps $n --out /tmp/v10/D_$n.out; done
stamp "--redarm observe_run"; t0=$(date +%s.%N)
python3 tools/pb/verify.py --redarm observe_run --task M0-V10; echo "exit $? wall $(echo "$(date +%s.%N) - $t0" | bc) s"
stamp done
