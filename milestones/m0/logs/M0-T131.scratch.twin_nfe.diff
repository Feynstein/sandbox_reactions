+
+/// M0-R13 scratch: Σ over the core (Σ ≥ sigma_core at the step's start) of Σε_th, its change by pass.
+pub struct R13 {
+    pub eos: crate::eos::Eos,
+    pub elements: Elements,
+    pub sigma_core: f64,
+    pub core: Vec<bool>,
+    /// P4, P5, P6, P8 (with the hold).
+    pub by_pass: [f64; 4],
+    pub nu_core: f64,
+    /// M0-T131: Σ over the core of the neutron mass N_Fe made (ΔΣ·X_n across P6).
+    pub dn_core: f64,
+    last: f64,
+}
+
+impl R13 {
+    pub fn new(eos: crate::eos::Eos, elements: Elements, sigma_core: f64) -> R13 {
+        R13 { eos, elements, sigma_core, core: Vec::new(), by_pass: [0.0; 4], nu_core: 0.0, dn_core: 0.0, last: 0.0 }
+    }
+    pub fn n_mass(&self, st: &State) -> f64 {
+        let n = st.cells();
+        (0..n).filter(|&i| self.core[i]).map(|i| st.planes[i] * st.planes[(4 + 9) * n + i]).sum()
+    }
+    pub fn heat(&self, st: &State) -> f64 {
+        let n = st.cells();
+        let mut h = 0.0;
+        for i in 0..n {
+            if !self.core[i] {
+                continue;
+            }
+            let s = st.planes[i];
+            let x: [f64; crate::registry::N_SPECIES] = std::array::from_fn(|k| st.planes[(4 + k) * n + i]);
+            let comp = self.elements.composition(&x);
+            let ke = 0.5 * (st.planes[n + i].powi(2) + st.planes[2 * n + i].powi(2)) / s;
+            h += st.planes[3 * n + i] - ke - s * self.eos.eps_cold(s, comp.y_e, x[9]);
+        }
+        h
+    }
+    fn start(&mut self, st: &State) {
+        self.core = (0..st.cells()).map(|i| st.planes[i] >= self.sigma_core).collect();
+        self.last = self.heat(st);
+    }
+    fn mark(&mut self, k: usize, st: &State) {
+        let h = self.heat(st);
+        self.by_pass[k] += h - self.last;
+        self.last = h;
+    }
 }
 
