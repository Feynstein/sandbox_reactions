+/// M0-D154 scratch: P5's frozen T⁰ and C, its iterate and its faces after a warned chunk — the cells whose build() terms
+/// (c u², (C/Δt) T²) or D_f leave f32's range, and the largest of each.
+fn d154_report(step: &crate::step::Step, gpu: &Gpu, w: usize, h: usize, at: u64) {
+    let a_r = 2e-5f32;
+    let rep = step.read_heat(&gpu.device, &gpu.queue);
+    let Some((fz, sv, faces)) = step.d154_planes(&gpu.device, &gpu.queue) else { return };
+    let n = w * h;
+    let dt = rep.as_ref().map_or(0.0, |r| r.dt);
+    println!("D154 after step {at}: report {:?}", rep.as_ref().map(|r| (r.dt, r.passes, r.rounds, r.converged, r.delta)));
+    let (mut s1, mut s2) = (0f32, 0f32);
+    let mut top: Vec<(f64, usize)> = Vec::new();
+    let mut bad = 0usize;
+    for i in 0..n {
+        let (t, c) = (fz[i], fz[n + i]);
+        if !(c > 0.0) {
+            continue;
+        }
+        let heat = c / dt;
+        let cc = heat * (1.0 / (4.0 * a_r * t * t * t));
+        let q = t * t;
+        let u = a_r * q * q;
+        let (a, b) = (cc * u * u, heat * t * t);
+        s1 += a;
+        s2 += b;
+        if !(a.is_finite() && b.is_finite() && t.is_finite()) {
+            bad += 1;
+            if bad <= 8 {
+                println!("D154   bad ({},{}) T0 {t:e} C {c:e} u {u:e} c {cc:e} cu2 {a:e} hT2 {b:e} x {:e} T {:e}", i % w, i / w, sv[i], sv[n + i]);
+            }
+        }
+        top.push((f64::from(c) / f64::from(dt) * f64::from(a_r) * f64::from(t).powi(5) / 4.0, i));
+    }
+    top.sort_by(|a, b| b.0.total_cmp(&a.0));
+    println!("D154   Σcu2 {s1:e} Σ(C/dt)T2 {s2:e} bad cells {bad}");
+    for (v, i) in top.iter().take(5) {
+        println!("D154   top ({},{}) cu2(f64) {v:e} T0 {:e} C {:e} x {:e} T {:e} D {:e}", i % w, i / w, fz[*i], fz[n + *i], sv[*i], sv[n + *i], sv[3 * n + *i]);
+    }
+    if let Some(m) = step.d154_machine(&gpu.device, &gpu.queue) {
+        for r in 0..2 {
+            let q = &m[16 * r..16 * r + 16];
+            let f = |i: usize| f32::from_bits(q[i]);
+            println!("D154   rec{r} slot {} mode {} passes {} rounds {} k {} parts {} tx {} ty {} dt {:e} heat0 {:e} u_bound {:e} t_bound {:e} gamma {:e} eta {:e}",
+                q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7], f(8), f(9), f(10), f(11), f(12), f(13));
+            let rdt = f(8);
+            if rdt > 0.0 {
+                let (mut z, mut ww, mut zt, mut wt) = (0f32, 0f32, 0f32, 0f32);
+                for i in 0..n {
+                    let c = fz[n + i];
+                    if !(c > 0.0) { continue; }
+                    let heat = c / rdt;
+                    for (t, zz, wq) in [(sv[n + i], &mut z, &mut ww), (fz[i], &mut zt, &mut wt)] {
+                        let cc = heat * (1.0 / (4.0 * a_r * t * t * t));
+                        let qq = t * t;
+                        let u = a_r * qq * qq;
+                        *zz += cc * u * u;
+                        *wq += heat * t * t;
+                    }
+                }
+                println!("D154   rec{r} build sums at the iterate T: {z:e} {ww:e} · at T0: {zt:e} {wt:e}");
+            }
+        }
+        println!("D154   report words {:?}", &m[32..44]);
+    }
+    if let Some(kr) = step.d154_krylov(&gpu.device, &gpu.queue) {
+        for par in 0..2 {
+            let r = &kr[par * n..(par + 1) * n];
+            let (mut rr, mut he, mut rr32bad, mut he32bad, mut rmax) = (0f64, 0f64, 0usize, 0usize, 0f64);
+            let (mut he_at, mut he_max) = (0usize, 0f64);
+            for i in 0..n {
+                let c = fz[n + i];
+                if !(c > 0.0) { continue; }
+                let (ri, d, t) = (r[i], sv[3 * n + i], sv[n + i]);
+                let slope = 1.0 / (4.0 * a_r * t * t * t);
+                let e32 = ri * slope / d;
+                if !((ri * ri / d).is_finite()) { rr32bad += 1; }
+                if !((c / dt * e32 * e32).is_finite()) { he32bad += 1; }
+                let (r64, d64, t64) = (f64::from(ri), f64::from(d), f64::from(t));
+                let e64 = r64 / (4.0 * f64::from(a_r) * t64.powi(3) * d64);
+                let hv = f64::from(c) / f64::from(dt) * e64 * e64;
+                rr += r64 * r64 / d64;
+                he += hv;
+                if hv > he_max { he_max = hv; he_at = i; }
+                rmax = rmax.max(r64.abs());
+            }
+            println!("D154   r[{par}] max |r| {rmax:e} · Σ r²/D {rr:e} (f32 terms not finite {rr32bad}) · Σ (C/Δt) ê² {he:e} (f32 terms not finite {he32bad}); its largest term {he_max:e} at ({},{}) T {:e} r {:e} D {:e}",
+                he_at % w, he_at / w, sv[n + he_at], r[he_at], sv[3 * n + he_at]);
+        }
+    }
+    let nd = (w + 1) * h + w * (h + 1);
+    let dmax = faces[..nd].iter().copied().filter(|v| v.is_finite()).fold(0f32, f32::max);
+    let dbad = faces[..nd].iter().filter(|v| !v.is_finite()).count();
+    let svbad: Vec<usize> = (0..5).map(|p| sv[p * n..(p + 1) * n].iter().filter(|v| !v.is_finite()).count()).collect();
+    println!("D154   D_f max {dmax:e} non-finite D_f {dbad} · solve non-finite per plane {svbad:?}");
+}
